                              "sub_conditions": {
                                "operator": "ALL_OF",
                                "criteria": [
                                  {
                                    "condition_id": "COND-IPM-FACET-P2-CONS-DUR",
                                    "parameter": "conservative_therapy_duration_weeks",
                                    "comparator": "GREATER_THAN_OR_EQUAL",
                                    "value": 6,
                                    "unit": "weeks"
