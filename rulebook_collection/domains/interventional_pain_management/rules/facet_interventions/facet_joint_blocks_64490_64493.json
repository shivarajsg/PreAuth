                                    "parameter": "conservative_therapy_duration_weeks",
                                    "comparator": "GREATER_THAN_OR_EQUAL",
                                    "value": 6,
                                    "unit": "weeks"
                                  },
                                  {
                                    "condition_id": "COND-IPM-FACET-P1-CONS-6M",
                                    "parameter": "conservative_therapy_within_6_months",
                                    "comparator": "EQUALS",
                                    "value": true
                                  }
                                ]
                              }
                            },
                            {
                              "condition_id": "COND-IPM-FACET-P1-CONS-ONGOING",
                              "description": "Details of engagement in ongoing non-operative conservative treatment",
                              "parameter": "ongoing_conservative_therapy",
                              "comparator": "EQUALS",
                              "value": true
                            },
                            {
                              "condition_id": "COND-IPM-FACET-P1-CONS-EXC",
                              "description": "Documented medical reason conservative therapy cannot be done",
                              "parameter": "conservative_therapy_exception_documented",
                              "comparator": "EQUALS",
                              "value": true
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
