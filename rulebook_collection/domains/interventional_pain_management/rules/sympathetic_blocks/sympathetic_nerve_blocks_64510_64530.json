        "criteria": [
          {
            "condition_id": "COND-IPM-SYMP-GUIDANCE",
            "description": "Each block must be performed under image guidance (ultrasound not permitted for thoracic, lumbar, or superior hypogastric blocks)",
            "parameter": "imaging_guidance_present",
            "comparator": "EQUALS",
            "value": true
          },
          {
            "condition_id": "COND-IPM-SYMP-UNILATERAL",
            "description": "Bilateral sympathetic blocks will not be performed on the same day of service",
            "parameter": "bilateral_procedure_requested",
            "comparator": "EQUALS",
            "value": false
          },
          {
            "condition_id": "COND-IPM-SYMP-BASELINE-PAIN",
